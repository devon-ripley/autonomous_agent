# OpenRouter API Key (required)
# Get one at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use (default: deepseek/deepseek-chat)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Initial goal for the agent
INITIAL_GOAL=Build yourself into a personal assistant with useful tools

# Command execution timeout in seconds (default: 300)
COMMAND_TIMEOUT=300

# Maximum retry attempts for commands and API calls (default: 3)
MAX_RETRIES=3

# Continuous mode - agent generates new goals after completing current one (default: true)
CONTINUOUS_MODE=true

# Rate limiting - seconds between LLM API calls (default: 2.0)
RATE_LIMIT_SECONDS=2.0

# Maximum output size in characters (default: 10000)
MAX_OUTPUT_SIZE=10000

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Memory configuration
MEMORY_TOP_K=5
CONTEXT_MAX_TOKENS=8000

# LLM parameters
TEMPERATURE=0.7
MAX_TOKENS=4000

# Terminal user credentials for sudo access (optional)
# Enable agent to execute privileged commands requiring sudo
TERMINAL_USERNAME=
TERMINAL_PASSWORD=
